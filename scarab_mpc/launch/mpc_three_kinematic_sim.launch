<launch>

  <!-- Phase 2: three independent MPC controllers in local kinematic simulation.
       The controllers do not load built-in trajectories; run
       pub_traj_test_real.py separately to publish /<robot>/move/goal.

       Role mapping follows pub_traj_test_real.py:
         robots[0] -> robot1 center path
         robots[1] -> robot2 left path
         robots[2] -> robot3 right path

       Default mapping:
         scarab42 -> robot1
         scarab40 -> robot2
         scarab46 -> robot3
  -->

  <arg name="agent0" default="scarab42" />
  <arg name="agent1" default="scarab40" />
  <arg name="agent2" default="scarab46" />
  <arg name="robots" default="$(arg agent0) $(arg agent1) $(arg agent2)" />

  <!-- Defaults match traj1 role initial waypoints. -->
  <arg name="spawn_x0" default="0.0" />
  <arg name="spawn_y0" default="3.0" />
  <arg name="spawn_yaw0" default="1.5708" />

  <arg name="spawn_x1" default="-0.6" />
  <arg name="spawn_y1" default="2.2" />
  <arg name="spawn_yaw1" default="1.5708" />

  <arg name="spawn_x2" default="0.6" />
  <arg name="spawn_y2" default="2.2" />
  <arg name="spawn_yaw2" default="1.5708" />

  <arg name="sim_rate" default="50.0" />
  <arg name="pose_rate" default="20.0" />
  <arg name="pose_topic" default="pose" />
  <arg name="goal_topic" default="move/goal" />
  <arg name="cmd_vel_topic" default="cmd_vel" />

  <arg name="dry_run" default="false" />
  <arg name="publish_cmd" default="true" />
  <arg name="reference_source" default="move_goal" />
  <arg name="start_delay" default="0.0" />
  <arg name="start_time" default="" />
  <arg name="mpc_config" default="$(find scarab_mpc)/config/mpc.yaml" />

  <arg name="monitor" default="true" />
  <arg name="test_timeout" default="90.0" />
  <arg name="test_goal_tolerance" default="0.35" />

  <node pkg="kinematic_sim" type="kinematic_sim" name="$(arg agent0)_kinematic_sim"
        output="screen">
    <param name="num_agents" value="1" />
    <param name="agent_prefix" value="name" />
    <param name="name0" value="$(arg agent0)" />
    <param name="initial0" value="$(arg spawn_x0) $(arg spawn_y0) $(arg spawn_yaw0)" />
    <param name="gt_pose_topic" value="$(arg pose_topic)" />
    <param name="gt_odom_topic" value="gt_odom" />
    <param name="base_frame_id" value="base_link" />
    <param name="odom_frame_id" value="odom" />
    <param name="global_frame_id" value="$(arg agent0)/map" />
    <param name="freq" value="$(arg sim_rate)" />
    <param name="publish_freq" value="$(arg pose_rate)" />
    <param name="pub_global_frame" value="true" />
  </node>

  <node pkg="kinematic_sim" type="kinematic_sim" name="$(arg agent1)_kinematic_sim"
        output="screen">
    <param name="num_agents" value="1" />
    <param name="agent_prefix" value="name" />
    <param name="name0" value="$(arg agent1)" />
    <param name="initial0" value="$(arg spawn_x1) $(arg spawn_y1) $(arg spawn_yaw1)" />
    <param name="gt_pose_topic" value="$(arg pose_topic)" />
    <param name="gt_odom_topic" value="gt_odom" />
    <param name="base_frame_id" value="base_link" />
    <param name="odom_frame_id" value="odom" />
    <param name="global_frame_id" value="$(arg agent1)/map" />
    <param name="freq" value="$(arg sim_rate)" />
    <param name="publish_freq" value="$(arg pose_rate)" />
    <param name="pub_global_frame" value="true" />
  </node>

  <node pkg="kinematic_sim" type="kinematic_sim" name="$(arg agent2)_kinematic_sim"
        output="screen">
    <param name="num_agents" value="1" />
    <param name="agent_prefix" value="name" />
    <param name="name0" value="$(arg agent2)" />
    <param name="initial0" value="$(arg spawn_x2) $(arg spawn_y2) $(arg spawn_yaw2)" />
    <param name="gt_pose_topic" value="$(arg pose_topic)" />
    <param name="gt_odom_topic" value="gt_odom" />
    <param name="base_frame_id" value="base_link" />
    <param name="odom_frame_id" value="odom" />
    <param name="global_frame_id" value="$(arg agent2)/map" />
    <param name="freq" value="$(arg sim_rate)" />
    <param name="publish_freq" value="$(arg pose_rate)" />
    <param name="pub_global_frame" value="true" />
  </node>

  <group ns="$(arg agent0)">
    <node name="mpc_controller" pkg="scarab_mpc" type="mpc_controller_node.py"
          output="screen">
      <rosparam command="load" file="$(arg mpc_config)" />
      <param name="agent" value="$(arg agent0)" />
      <param name="robot_index" value="0" />
      <param name="reference_source" value="$(arg reference_source)" />
      <param name="dry_run" value="$(arg dry_run)" />
      <param name="publish_cmd" value="$(arg publish_cmd)" />
      <param name="start_delay" value="$(arg start_delay)" />
      <param name="start_time" value="$(arg start_time)" />
      <param name="pose_topic" value="/$(arg agent0)/$(arg pose_topic)" />
      <param name="goal_topic" value="/$(arg agent0)/$(arg goal_topic)" />
      <param name="cmd_vel_topic" value="/$(arg agent0)/$(arg cmd_vel_topic)" />
      <param name="frame_id" value="$(arg agent0)/map" />
    </node>
  </group>

  <group ns="$(arg agent1)">
    <node name="mpc_controller" pkg="scarab_mpc" type="mpc_controller_node.py"
          output="screen">
      <rosparam command="load" file="$(arg mpc_config)" />
      <param name="agent" value="$(arg agent1)" />
      <param name="robot_index" value="1" />
      <param name="reference_source" value="$(arg reference_source)" />
      <param name="dry_run" value="$(arg dry_run)" />
      <param name="publish_cmd" value="$(arg publish_cmd)" />
      <param name="start_delay" value="$(arg start_delay)" />
      <param name="start_time" value="$(arg start_time)" />
      <param name="pose_topic" value="/$(arg agent1)/$(arg pose_topic)" />
      <param name="goal_topic" value="/$(arg agent1)/$(arg goal_topic)" />
      <param name="cmd_vel_topic" value="/$(arg agent1)/$(arg cmd_vel_topic)" />
      <param name="frame_id" value="$(arg agent1)/map" />
    </node>
  </group>

  <group ns="$(arg agent2)">
    <node name="mpc_controller" pkg="scarab_mpc" type="mpc_controller_node.py"
          output="screen">
      <rosparam command="load" file="$(arg mpc_config)" />
      <param name="agent" value="$(arg agent2)" />
      <param name="robot_index" value="2" />
      <param name="reference_source" value="$(arg reference_source)" />
      <param name="dry_run" value="$(arg dry_run)" />
      <param name="publish_cmd" value="$(arg publish_cmd)" />
      <param name="start_delay" value="$(arg start_delay)" />
      <param name="start_time" value="$(arg start_time)" />
      <param name="pose_topic" value="/$(arg agent2)/$(arg pose_topic)" />
      <param name="goal_topic" value="/$(arg agent2)/$(arg goal_topic)" />
      <param name="cmd_vel_topic" value="/$(arg agent2)/$(arg cmd_vel_topic)" />
      <param name="frame_id" value="$(arg agent2)/map" />
    </node>
  </group>

  <node if="$(arg monitor)"
        pkg="scarab_mpc"
        type="mpc_multi_sim_test_monitor.py"
        name="mpc_three_kinematic_monitor"
        output="screen"
        required="true">
    <param name="robots" value="$(arg robots)" />
    <param name="pose_topic_suffix" value="$(arg pose_topic)" />
    <param name="status_topic_suffix" value="mpc/status" />
    <param name="reference_path_topic_suffix" value="mpc/reference_path" />
    <param name="timeout" value="$(arg test_timeout)" />
    <param name="goal_tolerance" value="$(arg test_goal_tolerance)" />
  </node>

</launch>
