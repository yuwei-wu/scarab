Panels:
  - Class: rviz/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Grid1
        - /scarab421
        - /scarab401
        - /scarab461
      Splitter Ratio: 0.58
    Tree Height: 760
  - Class: rviz/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
  - Class: rviz/Time
    Name: Time
    SyncMode: 0
    SyncSource: ""
Preferences:
  PromptSaveOnExit: false
Toolbars:
  toolButtonStyle: 2
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 12
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz/Group
      Displays:
        - Alpha: 1
          Axes Length: 0.45
          Axes Radius: 0.04
          Class: rviz/Pose
          Color: 255; 80; 80
          Enabled: true
          Head Length: 0.35
          Head Radius: 0.12
          Name: Pose
          Queue Size: 10
          Shaft Length: 0.8
          Shaft Radius: 0.05
          Shape: Arrow
          Topic: /scarab42/pose
          Value: true
        - Alpha: 1
          Buffer Length: 1
          Class: rviz/Path
          Color: 0; 220; 90
          Enabled: true
          Line Style: Lines
          Line Width: 0.06
          Name: Reference
          Offset:
            X: 0
            Y: 0
            Z: 0
          Pose Style: None
          Queue Size: 10
          Topic: /scarab42/mpc/reference_path
          Value: true
        - Alpha: 1
          Buffer Length: 1
          Class: rviz/Path
          Color: 255; 190; 0
          Enabled: true
          Line Style: Lines
          Line Width: 0.07
          Name: Actual
          Offset:
            X: 0
            Y: 0
            Z: 0
          Pose Style: None
          Queue Size: 10
          Topic: /scarab42/mpc/actual_path
          Value: true
        - Alpha: 0.8
          Buffer Length: 1
          Class: rviz/Path
          Color: 0; 180; 255
          Enabled: true
          Line Style: Lines
          Line Width: 0.04
          Name: Prediction
          Offset:
            X: 0
            Y: 0
            Z: 0
          Pose Style: None
          Queue Size: 10
          Topic: /scarab42/mpc/predicted_path
          Value: true
      Enabled: true
      Name: scarab42
    - Class: rviz/Group
      Displays:
        - Alpha: 1
          Axes Length: 0.45
          Axes Radius: 0.04
          Class: rviz/Pose
          Color: 255; 80; 255
          Enabled: true
          Head Length: 0.35
          Head Radius: 0.12
          Name: Pose
          Queue Size: 10
          Shaft Length: 0.8
          Shaft Radius: 0.05
          Shape: Arrow
          Topic: /scarab40/pose
          Value: true
        - Alpha: 1
          Buffer Length: 1
          Class: rviz/Path
          Color: 0; 220; 90
          Enabled: true
          Line Style: Lines
          Line Width: 0.06
          Name: Reference
          Offset:
            X: 0
            Y: 0
            Z: 0
          Pose Style: None
          Queue Size: 10
          Topic: /scarab40/mpc/reference_path
          Value: true
        - Alpha: 1
          Buffer Length: 1
          Class: rviz/Path
          Color: 255; 190; 0
          Enabled: true
          Line Style: Lines
          Line Width: 0.07
          Name: Actual
          Offset:
            X: 0
            Y: 0
            Z: 0
          Pose Style: None
          Queue Size: 10
          Topic: /scarab40/mpc/actual_path
          Value: true
        - Alpha: 0.8
          Buffer Length: 1
          Class: rviz/Path
          Color: 0; 180; 255
          Enabled: true
          Line Style: Lines
          Line Width: 0.04
          Name: Prediction
          Offset:
            X: 0
            Y: 0
            Z: 0
          Pose Style: None
          Queue Size: 10
          Topic: /scarab40/mpc/predicted_path
          Value: true
      Enabled: true
      Name: scarab40
    - Class: rviz/Group
      Displays:
        - Alpha: 1
          Axes Length: 0.45
          Axes Radius: 0.04
          Class: rviz/Pose
          Color: 80; 180; 255
          Enabled: true
          Head Length: 0.35
          Head Radius: 0.12
          Name: Pose
          Queue Size: 10
          Shaft Length: 0.8
          Shaft Radius: 0.05
          Shape: Arrow
          Topic: /scarab46/pose
          Value: true
        - Alpha: 1
          Buffer Length: 1
          Class: rviz/Path
          Color: 0; 220; 90
          Enabled: true
          Line Style: Lines
          Line Width: 0.06
          Name: Reference
          Offset:
            X: 0
            Y: 0
            Z: 0
          Pose Style: None
          Queue Size: 10
          Topic: /scarab46/mpc/reference_path
          Value: true
        - Alpha: 1
          Buffer Length: 1
          Class: rviz/Path
          Color: 255; 190; 0
          Enabled: true
          Line Style: Lines
          Line Width: 0.07
          Name: Actual
          Offset:
            X: 0
            Y: 0
            Z: 0
          Pose Style: None
          Queue Size: 10
          Topic: /scarab46/mpc/actual_path
          Value: true
        - Alpha: 0.8
          Buffer Length: 1
          Class: rviz/Path
          Color: 0; 180; 255
          Enabled: true
          Line Style: Lines
          Line Width: 0.04
          Name: Prediction
          Offset:
            X: 0
            Y: 0
            Z: 0
          Pose Style: None
          Queue Size: 10
          Topic: /scarab46/mpc/predicted_path
          Value: true
      Enabled: true
      Name: scarab46
    - Alpha: 1
      Class: rviz/Axes
      Enabled: true
      Length: 1
      Name: Axes
      Radius: 0.025
      Reference Frame: <Fixed Frame>
      Show Trail: false
      Value: true
  Enabled: true
  Global Options:
    Background Color: 45; 45; 48
    Default Light: true
    Fixed Frame: scarab42/map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
      Hide Inactive Objects: true
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
  Value: true
  Views:
    Current:
      Angle: 0
      Class: rviz/TopDownOrtho
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Scale: 35
      Target Frame: <Fixed Frame>
      X: 0.0
      Y: 5.2
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 920
  Hide Left Dock: false
  Hide Right Dock: true
  Time:
    collapsed: false
  Views:
    collapsed: true
  Width: 1350
  X: 40
  Y: 40
